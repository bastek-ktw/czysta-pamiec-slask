# ==========================================
# CZYSTA PAMIĘĆ - KONFIGURACJA ŚRODOWISKA
# ==========================================

# 1. Baza Danych (Domyślnie lokalny SQLite, gotowy pod Turso / LibSQL w chmurze)
# Dla Vercel / Cloudflare: wystarczy założyć darmową bazę na Turso.tech i wkleić poniżej:
# DATABASE_URL="libsql://twoja-baza.turso.io"
# DATABASE_AUTH_TOKEN="twoj_turso_token"
DATABASE_URL="file:local.db"

# 2. Bezpieczeństwo Panelu Dyspozytora (/admin)
ADMIN_PIN="1920"

# 3. Opcjonalne Płatności Stripe
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
